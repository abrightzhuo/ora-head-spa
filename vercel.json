      "src": "^/(?:(?:zh|zh-tw|es|fr|ja|ko|de|ru)/)?(?:admin|account|account-lite|forum-lite)/?$",
      "dest": "/index.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },

    { "src": "^/(?!api/)(?!.*\\..*).*$", "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
