VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only Resend settings. Never prefix the API key with VITE_.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL="ORA Gift Cards <giftcards@your-verified-domain.com>"
RESEND_REPLY_TO_EMAIL=hello@your-verified-domain.com
PUBLIC_SITE_URL=https://ora-head-spa.vercel.app

# Optional SMS booking confirmations via Twilio.
TWILIO_ACCOUNT_SID=AC_your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15555555555
